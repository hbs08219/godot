#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

env_mcp = env.Clone()

# MCP模块源文件
mcp_sources = []

# 核心功能源文件
env_mcp.add_source_files(mcp_sources, "core/*.cpp")
env_mcp.add_source_files(mcp_sources, "commands/*.cpp")

# 编辑器插件源文件
if env["tools"]:
    env_mcp.add_source_files(mcp_sources, "editor/*.cpp")
    env_mcp.add_source_files(mcp_sources, "ui/*.cpp")

# 创建MCP模块库
lib = env_mcp.add_library("module_mcp", mcp_sources)
env.Prepend(LIBS=[lib])

# 导出环境
Export("env_mcp")
